# Environment for apps/docker-compose.e2e.yml (Playwright smoke suite).
# Committed on purpose: every value here is a dummy or a LocalStack default,
# none is a secret. Never put a real credential in this file.

# API Server configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=dev

# Database configuration
POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e
POSTGRES_DB=e2e
POSTGRES_PORT=5432
DB_URL=postgresql+asyncpg://e2e:e2e@postgres:5432/e2e

# Auth0 configuration (same dummies as ci.yml's unit-tests job; never contacted)
AUTH0_DOMAIN=ci-dummy-tenant.auth0.com
AUTH0_CLIENT_ID=ci-dummy-client
AUTH0_CLIENT_SECRET=ci-dummy-secret
AUTH0_REDIRECT_URI=http://localhost:5173/api/auth/callback
SESSION_SECRET=e2e-dummy-session-secret-000000000000000
AUTH0_M2M_CLIENT_ID=ci-dummy-m2m-client
AUTH0_M2M_CLIENT_SECRET=ci-dummy-m2m-secret

# Frontend configuration
FRONTEND_URL=http://localhost:5173

# The detector service is the stub in apps/detector-stub.py
DETECTOR_URL=http://detector:8001

# AWS Configuration (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ENDPOINT_URL_PUBLIC=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BATCHES_BUCKET=prompt-patrol-batches
SQS_BATCHES_QUEUE_URL=http://localstack:4566/000000000000/prompt-patrol-batches
SQS_BATCHES_DLQ_URL=http://localstack:4566/000000000000/prompt-patrol-batches-dlq
