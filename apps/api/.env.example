# API Server configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=dev

# Database configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DB_URL=

# Auth0 configuration
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=
SESSION_SECRET=

# Auth0 M2M configuration. Used for API access and user management, given the least privilege.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Frontend configuration
FRONTEND_URL=http://localhost:5173

# Internal-only URL of the standalone detector service
DETECTOR_URL=http://detector:8001

# The detector reports its model, calibration, threshold and abstention band with
# every score, and the API applies those, so leave these commented out. They are
# only the fallback for a detector too old to report them (and the e2e stub); when
# one is set and the detector disagrees, the detector wins and a warning is logged.
# Don't uncomment them with empty values: an empty DETECTOR_MODEL_VERSION is
# recorded as "" on every check instead of falling back to the default.
# DETECTOR_MODEL_VERSION=roberta-base-openai-detector-v0
# DETECTOR_CALIBRATION_VERSION=
# DETECTOR_THRESHOLD=
# ABSTENTION_BAND=

# AWS Configuration
AWS_REGION=your_aws_region
AWS_ENDPOINT_URL=your_aws_endpoint_url
AWS_ENDPOINT_URL_PUBLIC=your_aws_endpoint_url_public
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BATCHES_BUCKET=s3_bucket_name
SQS_BATCHES_QUEUE_URL=sqs_queue_url
SQS_BATCHES_DLQ_URL=dlq_url

# Strictness picker feature flag (openapi.yaml [0.36.0]). Off until 5%/0.1% thresholds are fitted.
STRICTNESS_ENABLED=false
