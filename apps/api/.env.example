API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=dev

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DB_URL=

# --- Login Variables---------------------------------------------------------------
# Microsoft Entra ID is the only way into the application, in every environment.
# All five are required; the app refuses to start if any is blank.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
SESSION_SECRET=

# Must resolve to the SAME HOST as ENTRA_REDIRECT_URI, and must be https unless
# that host is localhost. The session cookie is __Host--prefixed, which forbids a
# Domain attribute and pins the cookie to whichever host answers the callback -
# split across two hosts, sign-in succeeds and every later request is 401 with
# nothing logged. The app refuses to start on either mistake. Ports may differ.
FRONTEND_URL=http://localhost:5173

# Internal-only URL of the standalone detector service (apps/detector).
# Never exposed to the browser. Defaults to the docker-compose service name.
DETECTOR_URL=http://detector:8001
