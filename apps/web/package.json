{
  "name": "PromptPatrol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "predev": "npm run check:node",
    "dev": "vite",
    "prebuild": "npm run check:node",
    "build": "tsc -b && vite build",
    "prelint": "npm run check:node",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretypecheck": "npm run check:node",
    "typecheck": "tsc -b",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepreview": "npm run check:node",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-query": "^5.101.4",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
