# Prompt Patrol configuration. Copy to .env and fill in every blank value.
# The Auth0 values are sent to you separately; they are never inside this package.

# Image source and version. Leave commented to use the defaults baked into compose.yml.
# PP_REGISTRY=ghcr.io/zylooooo
# PP_VERSION=

# API server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=prod

# Database. Pick any values; DB_URL must be built from them:
#   postgresql+asyncpg://<user>:<password>@postgres:5432/<db>
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
DB_URL=

# Auth0 (login application). Sent to you separately.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Through the web app's nginx, like CloudFront in AWS. Must be in the Auth0 application's Allowed Callback URLs.
AUTH0_REDIRECT_URI=http://localhost:5173/api/auth/callback
# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Auth0 M2M application (creates user credentials). Sent to you separately.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Web app
FRONTEND_URL=http://localhost:5173

# Internal-only URL of the detector service. Don't change.
DETECTOR_URL=http://detector:8001

# Local S3/SQS stand-in (LocalStack). Don't change.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ENDPOINT_URL_PUBLIC=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BATCHES_BUCKET=prompt-patrol-batches
SQS_BATCHES_QUEUE_URL=http://localstack:4566/000000000000/prompt-patrol-batches
SQS_BATCHES_DLQ_URL=http://localstack:4566/000000000000/prompt-patrol-batches-dlq

# Strictness picker feature flag. Off until thresholds are fitted.
STRICTNESS_ENABLED=true
