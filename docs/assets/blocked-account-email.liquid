<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
{% comment %}
  Auth0 "Blocked Account Email" template, sent by Brute-force Protection.
  Source of truth for Branding > Email Templates; edit here first. Same shell
  as change-password-email.liquid. {{ url }} unblocks sign-in from the
  blocked IP; ignoring the email keeps that IP blocked for this user.
  Suggested subject: Sign-in to Prompt Patrol paused
{% endcomment %}
<html dir="ltr" lang="en">
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
  </head>
  <body
    style="margin:0;padding:16px 16px 40px;background-color:#f9fafc;font-family:Figtree, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;-webkit-font-smoothing:antialiased"
  >
    <div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">
      We paused sign-in to your Prompt Patrol account after several wrong passwords.
    </div>

    <table
      align="center"
      width="100%"
      border="0"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      style="margin:0 auto;max-width:37.5em;border-radius:12px;background-color:#ffffff;border:1px solid #d9ddec"
    >
      <tbody>
        <tr>
          <td style="padding:28px">
            <a href="{{ home_url | escape }}" target="_blank" style="display:block;text-align:center;text-decoration:none">
              <img
                src="https://app.prompt-patrol.com/brand/wordmark.png"
                width="150"
                height="58"
                alt="Prompt Patrol"
                style="display:block;margin:0 auto;border:0;outline:none;font-size:20px;line-height:28px;font-weight:700;color:#4338ca"
              />
            </a>
            <hr style="margin:20px 0;border:none;border-top:1px solid #d9ddec;width:100%" />

            <h1 style="margin:0 0 16px;text-align:center;font-size:24px;line-height:32px;font-weight:700;color:#1e2030">
              Sign-in paused on your account
            </h1>

            <p style="margin:0 0 20px;text-align:center;font-size:15px;line-height:24px;color:#585d75">
              Someone entered the wrong password for your Prompt Patrol account several times, so we paused sign-in from
              the address below. If that was you, unblock it and try again.
            </p>

            <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin:0 auto 24px">
              <tbody>
                <tr>
                  <td style="padding:2px 12px 2px 0;font-size:13px;line-height:20px;color:#6b7086">IP address</td>
                  <td style="padding:2px 0;font-size:13px;line-height:20px;color:#1e2030;font-family:'DM Mono', ui-monospace, Menlo, Consolas, monospace">{{ user.source_ip | escape }}</td>
                </tr>
                {% if user.city or user.country %}
                <tr>
                  <td style="padding:2px 12px 2px 0;font-size:13px;line-height:20px;color:#6b7086">Location</td>
                  <td style="padding:2px 0;font-size:13px;line-height:20px;color:#1e2030">{{ user.city | escape }}, {{ user.country | escape }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>

            <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin:0 auto">
              <tbody>
                <tr>
                  <td align="center" bgcolor="#4338ca" style="border-radius:8px;background-color:#4338ca">
                    <a
                      href="{{ url | escape }}"
                      target="_blank"
                      style="display:inline-block;min-width:160px;padding:12px 16px;border-radius:8px;font-size:14px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;text-align:center"
                      >Unblock sign-in</a
                    >
                  </td>
                </tr>
              </tbody>
            </table>

            <p style="margin:24px 0 4px;text-align:center;font-size:13px;line-height:20px;color:#6b7086">
              Button not working? Paste this link into your browser:
            </p>
            <p style="margin:0;text-align:center;font-size:13px;line-height:20px">
              <a href="{{ url | escape }}" target="_blank" style="word-break:break-all;color:#4338ca;text-decoration:underline"
                >{{ url | escape }}</a
              >
            </p>

            <p style="margin:24px 0 0;text-align:center;font-size:13px;line-height:20px;color:#6b7086">
              Wasn't you? Ignore this email and that address stays blocked. If you're worried, tell your Prompt Patrol
              administrator.
            </p>

            <hr style="margin:24px 0 16px;border:none;border-top:1px solid #d9ddec;width:100%" />
            <p style="margin:0;text-align:center;font-size:12px;line-height:16px;color:#6b7086">
              You're receiving this email because you have an account in {{ friendly_name | escape }}.{% if support_url != blank %}
              Need help? Visit our
              <a href="{{ support_url | escape }}" target="_blank" style="color:#4338ca;text-decoration:underline">Support Center</a>.{% endif %}
            </p>
          </td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
