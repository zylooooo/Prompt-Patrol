<mxCell id="step-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="4" vertex="1" parent="1"><mxGeometry x="632" y="540" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="5" vertex="1" parent="1"><mxGeometry x="1172" y="320" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" value="6" vertex="1" parent="1"><mxGeometry x="900" y="560" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="legend-bg" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" value="" vertex="1" parent="1"><mxGeometry height="820" width="650" x="1530" y="30" as="geometry" /></mxCell>
<mxCell id="legend-container" connectable="0" style="group" value="" vertex="1" parent="1"><mxGeometry height="780" width="602" x="1550" y="50" as="geometry" /></mxCell>
<mxCell id="step-1-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="98" width="600" x="0" y="0" as="geometry" /></mxCell>
<mxCell id="step-1-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="step-1-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Open the app&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Admin, instructor and TA use Chrome or Firefox on localhost:5173. nginx serves the React SPA and forwards /api/* to the API over the internal alb network.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend"><mxGeometry height="96" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="98" width="600" x="0" y="108" as="geometry" /></mxCell>
<mxCell id="step-2-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="step-2-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-2-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Sign in through Auth0&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Only the API has internet access (egress network): OIDC callback, JWKS and the Management API used to provision users. Auth0 sends the activation email through Resend. Sessions are stored in Postgres.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend"><mxGeometry height="96" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="98" width="600" x="0" y="216" as="geometry" /></mxCell>
<mxCell id="step-3-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="step-3-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-3-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Score a single answer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The API sends the text to the detector (desklib + MELD) over isolated-api, applies the threshold and records the check in Postgres. The detector has no database, no user identity and no internet.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-3-legend"><mxGeometry height="96" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="98" width="600" x="0" y="324" as="geometry" /></mxCell>
<mxCell id="step-4-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step-4-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-4-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Upload a batch CSV&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The API creates the batch, returns a presigned S3 URL and queues a job on SQS. The browser PUTs the CSV straight to LocalStack on localhost:4566.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-4-legend"><mxGeometry height="96" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="98" width="600" x="0" y="432" as="geometry" /></mxCell>
<mxCell id="step-5-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="step-5-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-5-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Score the batch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The worker polls SQS, reads the CSV from S3, scores each row through the detector and writes results to Postgres. It has no inbound ports and no internet.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-5-legend"><mxGeometry height="96" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="98" width="600" x="0" y="540" as="geometry" /></mxCell>
<mxCell id="step-6-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="step-6-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-6-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Purge old data&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;purge runs at start, then every 24 h: expired sessions and the 90-day hard delete of check history. Its own data-purge network reaches only Postgres.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-6-legend"><mxGeometry height="96" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="legend-note" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;i&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Only 127.0.0.1:5173 (web) and 127.0.0.1:4566 (S3 stand-in) are published to the host. Detector, worker, Postgres and purge have no ports and no internet. Arrows point from caller to callee, and edge labels name the Compose network.&lt;/span&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="100" width="560" x="20" y="660" as="geometry" /></mxCell>
</root></mxGraphModel></diagram></mxfile>
